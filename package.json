{
	"name": "*",
	"version": "0.1.0",
	"description": "*",
	"scripts": {
		"js": "esbuild ./develop/js/index.js --bundle --format=esm --minify --outdir=public/assets/js --sourcemap --target=chrome109,firefox115,safari15.8  \"--external:./polyfills/*\"",
		"js-dev": "npx esbuild ./develop/js/index.js --bundle --format=esm --outdir=public/assets/js --sourcemap --watch=\"forever\" \"--external:./polyfills/*\"",
		"js-lint": "npx eslint --fix develop/js",
		"css": "npx postcss develop/css/*.css --dir public/assets/css -m --env production",
		"css-dev": "npx postcss develop/css/*.css --dir public/assets/css -m -w --env development",
		"build": "npm run css; npm run js-lint; npm run js;",
		"test-live": "unlighthouse --config-file unlighthouse.config.ts --site https://stadtverwicklung.de",
		"test-local": "unlighthouse --config-file unlighthouse.config.ts --site https://stadtverwicklung.test"
	},
	"author": "hello@tobiaswolf.me",
	"devDependencies": {
		"@csstools/postcss-color-mix-function": "^4.0.4",
		"@csstools/postcss-oklab-function": "^5.0.4",
		"autoprefixer": "^10.5.0",
		"babel-loader": "^10.1.1",
		"cssnano": "^8.0.1",
		"esbuild": "0.27.1",
		"eslint": "^8.57.1",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-plugin-import": "^2.32.0",
		"postcss": "^8.5.15",
		"postcss-cli": "^11.0.1",
		"postcss-import": "^16.1.1",
		"postcss-nesting": "^13.0.2",
		"unlighthouse": "^0.17.9"
	}
}
